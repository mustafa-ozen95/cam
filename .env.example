# .env olarak kopyalayin (git'e girmez, izin 600) ya da degerleri platformun degisken ekranina girin.
# Listede olmayanlar icin bkz. config/app.mjs.

# Ilk cihazlar: yalniz veri/cihazlar.json yokken (sonra Cihaz sekmesinden). Tek satir, JSON tek tirnak icinde:
KAMERA_CIHAZLAR='[{"tur":"uniview","ana":"192.0.2.10","kullanici":"admin","parola":"PAROLA","etiket":"D"},{"tur":"hikvision","ana":"192.0.2.11","kullanici":"admin","parola":"PAROLA","etiket":"H"}]'
# Ilk acilista admin parolasi (yoksa rastgele uretilir: veri/ilk-admin.txt):
# KAMERA_ADMIN_PAROLA=

# Gorunum
# KAMERA_BASLIK=Kamera Paneli · NVR
# KAMERA_CEREZ=nvr_oturum

# /live (WebRTC): tarayiciya verilecek sunucu adresi; bos ise disaridan goruntu gelmez.
# KAMERA_RTC_ADRES=192.0.2.5
# KAMERA_RTC_PORT=8189
# /live'i kapatmak icin: KAMERA_RTC_API=
# /live kayitli duzen yokken gosterilecek kameralar: virgulle kanal no (1'den), sirayla. Bos = ilk 12 kamera.
# KAMERA_LIVE_VARSAYILAN=1,2,3,4

# Kimlik Yonetim Merkezi ile giris (bos = kapali)
# KAMERA_KIMLIK_ADRES=https://kimlik.ornek.test
# KAMERA_KIMLIK_ISTEMCI=
# KAMERA_KIMLIK_SIR=
# KAMERA_KIMLIK_DONUS=https://kamera.ornek.test/giris/merkez/geri
# KAMERA_KIMLIK_BILDIRIM_SIR=

# Guncelleme kontrolu: acik depo jetonsuz sorulur; ozel depo icin salt okunur jeton (Contents ve Actions: read)
# GUNCELLEME_JETONU=

# Ayni sunucuda ikinci kurulum
# KAMERA_KONTEYNER=cam
# KAMERA_RTC_KONTEYNER=cam-rtc
# KAMERA_VERI_VOLUME=cam_veri

# Deneme kurulumu: konteynerler cihazlara ve disariya baglanamaz
# AG_YALITIMI=true
