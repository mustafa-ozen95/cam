# .env olarak kopyalayin (git'e girmez, izin 600) ya da degerleri ortam degiskeni olarak verin.
# Listede olmayanlar icin bkz. config/app.mjs.

# Veritabani (zorunlu: DB_PASSWORD). Varsayilan kurulumda compose'taki db servisi kullanilir;
# disaridaki bir veritabani icin DB_HOST verin ve DB_REPLICAS=0 yapin (db servisi kalkmaz).
DB_PASSWORD=
# DB_DATABASE=cam
# DB_USERNAME=cam
# DB_HOST=db
# DB_PORT=3306
# DB_REPLICAS=0
# Acilista veritabani gelmezse beklenecek sure (sn):
# DB_WAIT_SEC=60

# Gizli anahtar (base64, 32 bayt): openssl rand -base64 32. VERITABANINA GIRMEZ; yedeklerle birlikte saklayin.
# Bos ise data/secret.key dosyasi kullanilir (yoksa uretilir). Farkli bir anahtarla acilis durur.
# CAM_SECRET_KEY=

# Ilk cihazlar: yalniz devices tablosu bosken (sonra Cihaz sekmesinden). Tek satir, JSON tek tirnak icinde:
CAM_DEVICES='[{"type":"uniview","host":"192.0.2.10","username":"admin","password":"PASSWORD","label":"D"},{"type":"hikvision","host":"192.0.2.11","username":"admin","password":"PASSWORD","label":"H"}]'
# Ilk acilista admin parolasi (yoksa rastgele uretilir: data/initial-admin.txt):
# CAM_ADMIN_PASSWORD=

# Gorunum
# CAM_TITLE=Kamera Paneli · NVR
# CAM_COOKIE=cam_session

# /live (WebRTC): tarayiciya verilecek sunucu adresi; bos ise disaridan goruntu gelmez.
# CAM_RTC_HOST=192.0.2.5
# CAM_RTC_PORT=8189
# /live'i kapatmak icin: CAM_RTC_API=
# /live kayitli duzen yokken gosterilecek kameralar: virgulle kanal no (1'den), sirayla. Bos = ilk 12 kamera.
# CAM_LIVE_DEFAULT=1,2,3,4

# Kimlik Yonetim Merkezi ile giris (bos = kapali)
# CAM_HUB_URL=https://kimlik.ornek.test
# CAM_HUB_CLIENT_ID=
# CAM_HUB_CLIENT_SECRET=
# CAM_HUB_REDIRECT_URI=https://kamera.ornek.test/login/hub/callback
# CAM_HUB_NOTIFY_SECRET=

# Guncelleme kontrolu: acik depo jetonsuz sorulur; ozel depo icin salt okunur jeton (Contents ve Actions: read)
# UPDATE_TOKEN=

# Ayni sunucuda ikinci kurulum
# CAM_CONTAINER=cam
# CAM_RTC_CONTAINER=cam-rtc
# CAM_DB_CONTAINER=cam-db
# CAM_DATA_VOLUME=cam_data
# CAM_DB_VOLUME=cam_database

# Deneme kurulumu: konteynerler cihazlara ve disariya baglanamaz
# CAM_NETWORK_ISOLATED=true
